# Public browser configuration for the MedPoint LOCAL MOCK / DEMO portal.
# The anon/publishable key is public by design; Supabase RLS and storage policies enforce access.
# Never put a service_role/secret key, database password, or access token here.
VITE_SUPABASE_URL=https://project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# GitHub Pages repository subpath. Use / for a custom domain.
VITE_BASE_PATH=/browser-agent-demo/

# Optional: password used by the sign-in "Fill demo credentials" helper. Must match the
# password used when seeding (default MedPointDemo!2026). VITE_DEMO_FILL=false hides the helper.
# VITE_DEMO_PASSWORD=
# VITE_DEMO_FILL=true
