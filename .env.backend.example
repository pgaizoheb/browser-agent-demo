# Local administrative configuration. Copy to .env.backend (gitignored). Never commit real values.
# Used only by `npm run demo:reset:remote` and Supabase CLI deployment commands.
SUPABASE_PROJECT_REF=project-ref
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# Session/transaction pooler connection string from Supabase → Project Settings → Database.
SUPABASE_DB_URL=
# Project Settings → API → service_role / secret key. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# Password assigned to the seeded synthetic demo accounts on the hosted project.
MP_DEMO_PASSWORD=
